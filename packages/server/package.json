    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@rca/shared": "*",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
