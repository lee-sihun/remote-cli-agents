{
  "name": "remote-cli-agents",
  "version": "0.1.0",
  "type": "module",
  "description": "Web-based remote control for CLI coding agents",
  "main": "./dist/index.js",
  "bin": {
    "rca": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "dist/",
    "web/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "node-pty": "^1.0.0",
